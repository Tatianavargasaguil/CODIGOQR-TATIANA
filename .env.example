# Configuración de Base de Datos PostgreSQL

# Usuario de la base de datos
DB_USER=postgres

# Contraseña de la base de datos
DB_PASSWORD=postgres

# Host de la base de datos (localhost si es local, 'db' si es con Docker)
DB_HOST=db

# Puerto de la base de datos
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=codigoqr_db
# ===== Seguridad y Autenticación =====
# Usuario y contraseña para el panel de administración
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_contrasena
ADMIN_USERS=

# Secreto para firmar sesiones (cambiar en producción a 32+ caracteres aleatorios)
SESSION_SECRET=genera_un_valor_largo_con_python_secrets_token_urlsafe

# Orígenes CORS permitidos (separados por comas)
# Ejemplo: http://localhost:8001,https://example.com
ALLOWED_ORIGINS=http://localhost:8001
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Cotizador IA
# Pega aqui la llave real si quieres que consulte DeepSeek.
CARMAX_DEEPSEEK_API_KEY=
